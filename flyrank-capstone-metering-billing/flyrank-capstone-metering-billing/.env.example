# Copy to .env and fill in. .env is git-ignored; this file holds placeholders only.
# Everything here is optional for the metering core. Stripe values are needed only for checkout/webhooks.

# Where the SQLite file lives (created automatically)
DATABASE_PATH=billing.db

# Used to build the Checkout success/cancel links
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# Stripe TEST MODE only (dashboard.stripe.com/test/apikeys). Never use a live key (sk_live_...).
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to localhost:8080/webhooks/stripe` as "Your webhook signing secret is whsec_..."
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# The price id (price_...) of your $20/month "Pro" product, created in the Stripe test dashboard
STRIPE_PRO_PRICE_ID=price_replace_me
